# ---------------------------------------------------------------------------
# Media Context MCP configuration
#
# Every setting is read from the environment with the MEDIA_MCP_ prefix.
# A .env file in the working directory is loaded automatically if present,
# but environment variables always win over the file.
# ---------------------------------------------------------------------------

# REQUIRED. Directories the server is allowed to read from.
# Separate multiple roots with the OS path separator (';' on Windows, ':' elsewhere),
# or supply a JSON array: ["/home/me/work","/home/me/docs"]
# Files outside these roots are rejected with PATH_NOT_ALLOWED.
MEDIA_MCP_ALLOWED_ROOTS=/absolute/path/to/workspace

# --- Resource limits -------------------------------------------------------
MEDIA_MCP_MAX_FILE_MB=50
MEDIA_MCP_MAX_PAGES=30
MEDIA_MCP_MAX_IMAGE_PIXELS=40000000
MEDIA_MCP_MAX_OUTPUT_CHARS=100000
MEDIA_MCP_PROCESS_TIMEOUT_SECONDS=120

# --- Cache -----------------------------------------------------------------
MEDIA_MCP_CACHE_ENABLED=true
# Relative paths resolve against the server's working directory.
MEDIA_MCP_CACHE_DIR=.media-context-mcp/cache
MEDIA_MCP_CACHE_MAX_MB=1024
MEDIA_MCP_CACHE_TTL_DAYS=30

# --- OCR (local, no network) -----------------------------------------------
# Backends: tesseract | none
MEDIA_MCP_OCR_BACKEND=tesseract
MEDIA_MCP_OCR_LANGUAGES=eng+vie
# Optional explicit path to the tesseract binary (needed on Windows if not on PATH).
# MEDIA_MCP_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Cloud privacy gates ---------------------------------------------------
# Cloud vision sends images (screenshots may contain secrets or proprietary
# code!) to a remote provider. It is OFF by default and requires explicit
# opt-in. When false: mode=vision fails with CLOUD_VISION_DISABLED, and
# mode=auto uses local document extraction and OCR only.
MEDIA_MCP_ALLOW_CLOUD_VISION=false
# Independently controls whether locally-extracted OCR text may be included in
# a cloud vision request (as an untrusted candidate transcription).
MEDIA_MCP_SEND_OCR_TO_CLOUD=true

# --- Vision provider (OpenAI-compatible chat/completions) -------------------
# Provider kinds: openai-compatible | huggingface
# 'huggingface' is a preset over the same client: it fills in the router base
# URL (https://router.huggingface.co/v1) so only model + key are needed.
MEDIA_MCP_VISION_PROVIDER=openai-compatible
MEDIA_MCP_VISION_BASE_URL=
MEDIA_MCP_VISION_API_KEY=
# Example (verify current availability first): Qwen/Qwen2.5-VL-7B-Instruct
MEDIA_MCP_VISION_MODEL=
# Optional explicit route/annotation; never dynamic by default.
MEDIA_MCP_VISION_ROUTE=
# Explicitly configured fallback models, comma-separated. The server never
# switches models silently; an empty list means no fallback.
MEDIA_MCP_VISION_FALLBACK_MODELS=
MEDIA_MCP_VISION_TIMEOUT_SECONDS=60
MEDIA_MCP_VISION_MAX_RETRIES=1
MEDIA_MCP_VISION_MAX_OUTPUT_TOKENS=1400
# Hugging Face extras (only used when MEDIA_MCP_VISION_PROVIDER=huggingface):
# provider-selection policy suffix (e.g. 'fastest') -- explicit only, reduces
# reproducibility; and an org to bill via X-HF-Bill-To.
MEDIA_MCP_HF_PROVIDER_POLICY=
MEDIA_MCP_HF_BILL_TO=

# --- Vision image preprocessing --------------------------------------------
MEDIA_MCP_VISION_MAX_DIMENSION=4096
MEDIA_MCP_VISION_MAX_IMAGE_BYTES=10485760
# auto (PNG unless over budget, keeps text crisp) | png | jpeg
MEDIA_MCP_VISION_IMAGE_FORMAT=auto

# --- Routing heuristics ----------------------------------------------------
# Image strategy for mode=auto: ocr_first | vision_first | hybrid (recommended).
# hybrid: OCR runs locally first; clearly text-extraction questions with good
# OCR are answered locally; everything else escalates to vision with the OCR
# text attached as an untrusted candidate.
MEDIA_MCP_AUTO_IMAGE_STRATEGY=hybrid
# A PDF page yielding fewer useful characters than this is treated as scanned
# and sent to the OCR/vision fallback.
MEDIA_MCP_PDF_MIN_CHARS_PER_PAGE=120
# DPI used when rasterising PDF pages for OCR or vision.
MEDIA_MCP_PDF_RENDER_DPI=160

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs go to STDERR (never STDOUT).
MEDIA_MCP_LOG_LEVEL=INFO
# Optional log file; STDERR is always used as well.
# MEDIA_MCP_LOG_FILE=.media-context-mcp/server.log
